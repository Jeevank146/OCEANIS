# ==============================================================================
# OCEANIS Backend Environment Configuration (.env.example)
# ==============================================================================
# Note: Copy this file to .env and configure the necessary credentials.
# Do NOT commit real secrets or credentials to source control.

# --- Core Database & PostGIS ---
DATABASE_URL=postgresql+psycopg://oceanis:oceanis_dev_2026@localhost:5432/oceanis

# --- FastAPI Backend Server ---
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Primary Marine Provider: INCOIS ---
# Indian National Centre for Ocean Information Services
# Required for real-time wave buoys, OSF forecasts, and PFZ advisories
INCOIS_API_KEY=
INCOIS_BASE_URL=https://incois.gov.in/portal/datainfo
INCOIS_ENABLED=true

# --- Primary Meteorological Provider: IMD ---
# India Meteorological Department
# Required for coastal Doppler Weather Radars, squall warnings, and RSMC cyclone bulletins
IMD_API_KEY=
IMD_BASE_URL=https://mausam.imd.gov.in/api
IMD_ENABLED=true

# --- Earth Observation & Bio-optics: Copernicus Marine (CMEMS) ---
# European Space Agency (ESA) / EUMETSAT Sentinel-3 missions
# Required for Sentinel-3 SLSTR SST, OLCI chlorophyll-a, and CMEMS physics
COPERNICUS_API_KEY=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
COPERNICUS_BASE_URL=https://marine.copernicus.eu/api
COPERNICUS_ENABLED=true

# --- High-Availability Fallback Provider ---
# Open-Meteo Marine / Weather (Assimilating NOAA GFS, ECMWF IFS, and DWD models)
FALLBACK_MARINE_API_URL=http://marine-api.open-meteo.com/v1/marine
FALLBACK_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
FALLBACK_ENABLED=true

# --- Default Provider Routing ---
MARINE_DATA_PRIMARY_PROVIDER=INCOIS
WEATHER_DATA_PRIMARY_PROVIDER=IMD
EO_DATA_PRIMARY_PROVIDER=Copernicus
